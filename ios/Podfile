# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
use_modular_headers!

prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Patrn' do
  config = use_native_modules!

  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => false,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # RN 0.82.1 bug: two pod pairs share the same header_dir with no module_name set.
    # CocoaPods derives the same module name for both pods in each pair, generating two
    # modulemaps that both define the same module. xcconfigs pass both via -fmodule-map-file,
    # causing Clang to error "Redefinition of module '...'". The subordinate pod in each
    # pair is emptied so the canonical pod solely owns the module name.
    #
    # Pair 1: react_runtime — React-jsitooling (subordinate) vs React-RuntimeCore (canonical)
    # Pair 2: ReactCommon  — React-RuntimeApple (subordinate) vs ReactCommon (canonical)
    {
      "Headers/Public/react_runtime/React-jsitooling.modulemap"        => "React-jsitooling",
      "Target Support Files/React-jsitooling/React-jsitooling.modulemap" => "React-jsitooling",
      "Headers/Public/ReactCommon/React-RuntimeApple.modulemap"         => "React-RuntimeApple",
      "Target Support Files/React-RuntimeApple/React-RuntimeApple.modulemap" => "React-RuntimeApple",
    }.each do |rel_path, pod_name|
      path = File.join(installer.sandbox.root, rel_path)
      if File.exist?(path) && !File.read(path).empty?
        File.write(path, "")
        Pod::UI.puts "[MODULE FIX] Emptied duplicate modulemap for #{pod_name}: #{File.basename(path)}".yellow
      end
    end

    # Fix deployment target for Xcode 26.5
    # Also disable user script sandboxing — Xcode 26 blocks the CocoaPods
    # "Embed Pods Frameworks" rsync from reading XCFrameworkIntermediates paths.
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
        config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      end
    end

    # Fix fmt for Xcode 26.x
    fmt_base_h = File.join(
      installer.sandbox.root,
      'fmt',
      'include',
      'fmt',
      'base.h'
    )

    if File.exist?(fmt_base_h)
      original = File.read(fmt_base_h)
      patched = original.gsub(
        '#  define FMT_USE_CONSTEVAL 1',
        '#  define FMT_USE_CONSTEVAL 0'
      )

      if patched != original
        File.write(fmt_base_h, patched)
        Pod::UI.puts "[FMT FIX] Forced FMT_USE_CONSTEVAL=0".green
      end
    end
  end
end